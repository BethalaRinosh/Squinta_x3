# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
VITE_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5176
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models

# Gemini API key for high-quality OCR (get from https://aistudio.google.com/apikey)
# IMPORTANT: this must be a Gemini API key, not a Google OAuth access token.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Photos (uses same OAuth client, just needs extra scopes)
# Scopes are configured in auth.py
